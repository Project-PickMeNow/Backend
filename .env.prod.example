# 프로덕션 .env 예시 (EC2 의 ~/app/.env 에 둔다). 절대 커밋하지 않는다.
# docker-compose.prod.yml 이 이 값들을 읽는다.

# 앱 이미지 — CI(deploy.yml)가 배포 때 커밋 SHA 태그로 자동 갱신한다.
DOCKER_IMAGE=<도커허브계정>/siheung-backend:latest

# ── Caddy (HTTPS/wss 리버스 프록시) ──
# 백엔드 도메인. 이 도메인의 DNS A 레코드가 EC2 퍼블릭 IP 를 가리켜야 인증서가 발급된다.
# 앱은 이 도메인 하나로 REST(https)·소켓(wss) 을 모두 받는다.
DOMAIN=api.your-domain.com
# 인증서 만료 알림 이메일(선택 — 비워도 발급됨).
ACME_EMAIL=you@your-domain.com

# ── 앱 ──
# 컨테이너 내부 포트는 compose 가 3000 으로 고정. 외부 노출은 Caddy(80/443)만 하므로
# 앱 호스트 포트 매핑(APP_PORT)은 더 이상 쓰지 않는다.
# CORS 허용 오리진. 콤마로 여러 개 줄 수 있다(apex·www 둘 다 허용 권장).
CORS_ORIGIN=https://your-frontend.example.com,https://www.your-frontend.example.com
# 참가 링크(QR) 생성용 — 대표(canonical) 프론트 주소 하나만.
FRONTEND_BASE_URL=https://your-frontend.example.com
# 방 TTL(초) — 3일. 방 정원은 방마다 host 가 설정한다(기본 200·상한 200).
ROOM_TTL_SECONDS=259200

# ── PostgreSQL ──
# 아래 3개는 postgres 컨테이너 초기화에 쓰이고, DATABASE_URL 과 반드시 일치해야 한다.
POSTGRES_USER=pickmeup
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=pickmeup
# 앱 접속 URL — host 는 compose 서비스명 'postgres'
DATABASE_URL=postgresql://pickmeup:change-me-strong-password@postgres:5432/pickmeup?schema=public

# ── Redis ──
# host 는 compose 서비스명 'redis'
REDIS_HOST=redis
REDIS_PORT=6379

# ── 모니터링 (Grafana) ──
# docker-compose.monitoring.prod.yml 이 읽는다. 없으면 Grafana 컨테이너가 뜨지 않는다.
# Grafana 는 127.0.0.1:3002 로만 열리므로 SSH 터널로 접속한다:
#   ssh -L 3002:localhost:3002 <ec2>   후  http://localhost:3002  (로그인 admin / 아래 값)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-password
