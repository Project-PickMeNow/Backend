# 프로덕션 .env 예시 (EC2 의 ~/app/.env 에 둔다). 절대 커밋하지 않는다.
# docker-compose.prod.yml 이 이 값들을 읽는다.

# 앱 이미지 — CI(deploy.yml)가 배포 때 커밋 SHA 태그로 자동 갱신한다.
DOCKER_IMAGE=<도커허브계정>/siheung-backend:latest

# ── 앱 ──
# 컨테이너 내부 포트는 compose 가 3000 으로 고정. APP_PORT 는 호스트 노출 포트.
APP_PORT=3000
# 프론트 도메인 (CORS 허용 + 참가 링크 생성용)
CORS_ORIGIN=https://your-frontend.example.com
FRONTEND_BASE_URL=https://your-frontend.example.com
# 방 TTL(초) — 3일 / 방 정원
ROOM_TTL_SECONDS=259200
ROOM_MAX_PARTICIPANTS=50

# ── PostgreSQL ──
# 아래 3개는 postgres 컨테이너 초기화에 쓰이고, DATABASE_URL 과 반드시 일치해야 한다.
POSTGRES_USER=pickmeup
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=pickmeup
# 앱 접속 URL — host 는 compose 서비스명 'postgres'
DATABASE_URL=postgresql://pickmeup:change-me-strong-password@postgres:5432/pickmeup?schema=public

# ── Redis ──
# host 는 compose 서비스명 'redis'
REDIS_HOST=redis
REDIS_PORT=6379
